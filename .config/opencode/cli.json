{
  "$schema": "https://opencode.ai/v2/cli.json",
  "session": {
    "sidebar": "hide",
    "verbosity": "medium",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "tps": true,
    "permissions": "prompt",
    "new_location": "launch"
  },
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "animations": false,
  "tabs": {
    "mode": "off",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "prompt": {
    "paste": "compact"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
