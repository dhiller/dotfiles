{
  "$schema": "https://app.opencode.ai/config.json",
  "disabled_providers": ["opencode", "mistral"],
  "skills": {
    "paths": [
      "~/Projects/github.com/.claude/skills",
      "~/Projects/github.com/kubevirt.io/ci-health/.claude/skills"
    ]
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    }
  },
  "providers": {
    "enmaas": {
      "name": "EnMaaS",
      "env": ["ENMAAS_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1"
      },
      "models": {
         "rits/zai-org/glm-5-3": {
           "name": "GLM 5.3",
           "limit": { "context": 1048576, "output": 65536 }
         },
         "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
           "name": "DeepSeek V4.1 Flash"
         }
      }
    },
    "openai": {"env": ["ENMAAS_KEY"],
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" }
    },
    "anthropic": {
      "env": ["ENMAAS_KEY"],
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" }
    }
  },
  "permissions": [
    { "action": "atlassian_*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "bash *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "skopeo *", "effect": "allow" },
    { "action": "shell", "resource": "kilo *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/go/pkg/mod/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/Pictures/Screenshots/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.gimme/versions/go1.26.4.linux.amd64/src/crypto/tls/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.cache/bazel/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.cache/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.config/yamllint/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/Music/scripts/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/Projects/github.com/dhiller/claude-code-container-kilo/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/proc/self/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/kilo/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/local/bin/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.gimme/versions/go1.26.4.linux.amd64/src/cmd/go/internal/load/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/local/lib/node_modules/@kilocode/cli/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/dhiller/.gimme/versions/go1.26.4.linux.amd64/src/net/http/*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "atlassian_addGraphContext", "resource": "*", "effect": "allow" },
    { "action": "atlassian_atlassianUserInfo", "resource": "*", "effect": "allow" },
    { "action": "atlassian_discover", "resource": "*", "effect": "allow" },
    { "action": "atlassian_executeRead", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getAccessibleAtlassianResources", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getCollaborators", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluenceContent", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getGraphContext", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getGraphObject", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getJiraIssue", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getLoomObjectsContent", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getPeopleInfo", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getWorkActivity", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getWorkPortfolio", "resource": "*", "effect": "allow" },
    { "action": "atlassian_listJiraIssueComments", "resource": "*", "effect": "allow" },
    { "action": "atlassian_search", "resource": "*", "effect": "allow" },
    { "action": "atlassian_searchConfluence", "resource": "*", "effect": "allow" },
    { "action": "atlassian_searchJiraIssuesUsingJql", "resource": "*", "effect": "allow" }
  ]
}
